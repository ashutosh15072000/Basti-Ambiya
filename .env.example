# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB CONFIGURATION (Optional for RSVP Excel automatic commits):
# GITHUB_TOKEN: Personal access token with 'repo' scope to push updated RSVP Excel file to GitHub
GITHUB_TOKEN=""
# GITHUB_OWNER: GitHub username or organization (e.g. "ashutoshs019")
GITHUB_OWNER=""
# GITHUB_REPO: Repository name (e.g. "wedding-invitation")
GITHUB_REPO=""
# GITHUB_BRANCH: Target branch to commit the Excel file to (default: "main")
GITHUB_BRANCH="main"

